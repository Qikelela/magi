* {
    background-color: #232323;
    color: #D6D6D6;
}

QMainWindow {
    background-color: #FFFFFF;
    background: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:1, stop:0 #232323, stop:1.0 #010101); 
}

QToolBar {
    background-color: #2B2B2B;
    height: 50px;
    border-bottom: 2px solid #1D62F0;
}

QToolBar > .toolbarSpacer {
    min-width: 75px;
    border: 1px solid transparent;
    border-top: 2px solid #1D62F0;
    margin-top: 10px;
    margin-left: 20px;
    margin-right: 20px;
}

QToolBar > QToolButton {
    border: 0px;
    background-color: #2B2B2B;
    color: #4CD964;
    margin-top: 10px;
    margin-bottom: 10px;
    margin-left: 0px;
    margin-right: 0px;
    height: 20px;
    font-size: 10px;
    font-weight: 1250;
    padding-top: 5px;
    padding-bottom: 5px;
    padding-left: 3px;
    padding-right: 3px;
    border-radius: 4px;
}

QToolBar > QToolButton:checked {
    color: #1D77EF;
    margin-top: 10px;
    margin-bottom: 10px;
    margin-left: 0px;
    margin-right: 0px;
    height: 20px;
    font-weight: 1250;
    padding-top: 5px;
    padding-bottom: 5px;
    padding-left: 3px;
    padding-right: 3px;
    border-radius: 4px;
}

QToolBar > QToolButton:checked:hover {
    background-color: #3A3A3A;
}

QToolBar > QToolButton:hover {
    background-color: #3A3A3A;
}

QLabel {
    color: #D6D6D6;
    background-color: transparent;
}

QCheckBox {
    color: #D6D6D6;
    background-color: transparent;
    border-radius: 4px;
}

QDialog {
    color: #D6D6D6;
    background-color: transparent;
}

QDoubleSpinBox { /* send кол во */
    background-color: #232323;
    height: 20px;
    border: 1px solid #363636;
    border-radius: 4px;
}

QLineEdit { /* поля ввода */
    background-color: #232323;
    height: 20px;
    border: 1px solid #363636;
    border-radius: 4px;
}

QMessageBox {
    background-color: #232323;
    border-radius: 4px;
}

QStatusBar {
    border-top: 2px solid #1D62F0;
    color: #FFFFF0;
    background-color: #232323;
}

QStatusBar .progressBarLabel {
    color: #D6D6D6;
    background-color: #232323;
}

QToolButton:disabled {
    background-color: #232323;
    border: 1px solid #363636;
}

QToolTip {
    color: #D6D6D6; 
    background-color: #232323;
    border: 1px solid #3A3A3A;
}

QProgressBar {
    background-color: #232323;
    border: 1px solid #363636;
    border-radius: 4px;
    padding: 1px;
    text-align: center;
} 

QProgressBar::chunk {
    background: QLinearGradient(x1: 0, y1: 0, x2: 1, y2: 0, stop: 0 #469047, stop: 1 ##316431); 
    border-radius: 4px; 
    margin: 0px;
}

QPushButton {
    background-color: #232323;
    color: #D6D6D6;
    border-radius: 4px;
    padding: 5px;
}
