QMainWindow {
    background: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:1,
                              stop:0 #1e1e1e, stop:1 #0e0e0e);
}

QToolBar {
    background-color: #1f1f1f;
    height: 50px;
    border-bottom: 2px solid #3a86ff;
}

QToolBar > .toolbarSpacer {
    min-width: 75px;
    border: 1px solid transparent;
    border-top: 2px solid #3a86ff;
    margin-top: 10px;
    margin-left: 20px;
    margin-right: 20px;
}

QTextEdit {
    background-color: #1e1e1e;
    color: #d0d0d0;
}

QToolBar > QToolButton {
    border: 0px;
    background-color: #1f1f1f;
    color: #6cd964;
    margin-top: 10px;
    margin-bottom: 10px;
    margin-left: 0px;
    margin-right: 0px;
    height: 20px;
    font-size: 10px;
    font-weight: 500;
    padding-top: 5px;
    padding-bottom: 5px;
    padding-left: 3px;
    padding-right: 3px;
    border-radius: 4px;
}

QToolBar > QToolButton:checked {
    color: #4a86ff;
    margin-top: 10px;
    margin-bottom: 10px;
    margin-left: 0px;
    margin-right: 0px;
    height: 20px;
    font-weight: 500;
    padding-top: 5px;
    padding-bottom: 5px;
    padding-left: 3px;
    padding-right: 3px;
    border-radius: 4px;
}

QToolBar > QToolButton:checked:hover {
    background-color: #2d2d2d;
}

QToolBar > QToolButton:hover {
    background-color: #2d2d2d;
}

QLabel {
    color: #d0d0d0;
    background-color: transparent;
}

QCheckBox {
    color: #d0d0d0;
    background-color: transparent;
    border-radius: 4px;
}

QDialog {
    color: #d0d0d0;
    background-color: #1e1e1e;
}

QDoubleSpinBox, QLineEdit {
    background-color: #1e1e1e;
    height: 20px;
    border: 1px solid #303030;
    border-radius: 4px;
    padding: 0 4px;
}

QMessageBox {
    background-color: #1e1e1e;
    border-radius: 4px;
    color: #d0d0d0;
}

QStatusBar {
    border-top: 2px solid #3a86ff;
    color: #ffffff;
    background-color: #1e1e1e;
    padding: 3px;
}

QStatusBar .progressBarLabel {
    color: #d0d0d0;
    background-color: transparent;
}

QToolButton:disabled {
    background-color: #1e1e1e;
    border: 1px solid #303030;
    color: #5e5e5e;
}

QToolTip {
    color: #d0d0d0;
    background-color: #1e1e1e;
    border: 1px solid #3a3a3a;
    padding: 4px;
}

QProgressBar {
    background-color: #1e1e1e;
    border: 1px solid #303030;
    border-radius: 4px;
    padding: 1px;
    text-align: center;
}

QProgressBar::chunk {
    background: QLinearGradient(x1: 0, y1: 0, x2: 1, y2: 0,
                               stop: 0 #469047, stop: 1 #316431);
    border-radius: 4px;
    margin: 0px;
}

QPushButton {
    background-color: #2a2a2a;
    color: #d0d0d0;
    border-radius: 4px;
    padding: 5px;
}

QPushButton:hover {
    background-color: #3a3a3a;
}

QPushButton:pressed {
    background-color: #1e1e1e;
}

QTableView {
    background-color: #1e1e1e;
    color: #d0d0d0;
    border: 1px solid #303030;
    border-radius: 4px;
    gridline-color: #303030;
    selection-background-color: #3a86ff;
    selection-color: #ffffff;
    alternate-background-color: #252525;
    padding: 2px;
}

QHeaderView::section {
    background-color: #1f1f1f;
    color: #d0d0d0;
    border: 1px solid #303030;
    border-radius: 0px;
    padding: 4px;
}

QHeaderView::section:hover {
    background-color: #2d2d2d;
}

QHeaderView::section:pressed {
    background-color: #1e1e1e;
}

QScrollArea {
    background-color: #1e1e1e;
    border: 1px solid #303030;
    border-radius: 4px;
    padding: 0;
    margin: 0;
}

QScrollArea QFrame {
    background-color: #1e1e1e;
    border: none;
    padding: 8px;
}

QScrollArea QAbstractScrollArea {
    border: none;
    background-color: #1e1e1e;
}

QScrollBar:horizontal {
    background: #1e1e1e;
    height: 12px;
    border-radius: 3px;
    margin: 2px 0;
}

QScrollBar::handle:horizontal {
    background: #3a3a3a;
    border-radius: 3px;
    min-width: 20px;
}

QScrollBar:vertical {
    background: #1e1e1e;
    width: 12px;
    border-radius: 3px;
    margin: 0 2px;
}

QScrollBar::handle:vertical {
    background: #3a3a3a;
    border-radius: 3px;
    min-height: 20px;
}

QValueComboBox {
    background-color: #1e1e1e;
    color: #d0d0d0;
    border: 1px solid #303030;
    border-radius: 4px;
    padding: 2px 4px;
    min-width: 120px;
    min-height: 24px;
    selection-background-color: #3a86ff;
    selection-color: #ffffff;
}

QValueComboBox QAbstractItemView {
    background-color: #1e1e1e;
    border: none;
    color: #d0d0d0;
    outline: none;
    selection-background-color: #3a86ff;
    selection-color: #ffffff;
}

QValueComboBox::drop-down {
    border: none;
    width: 20px;
    background-color: transparent;
    border-left: 1px solid #303030;
    border-top-right-radius: 3px;
    border-bottom-right-radius: 3px;
}

QValueComboBox::down-arrow {
    width: 8px;
    height: 8px;
    image: none;
    border-top: 3px solid #6cd964;
    border-left: 3px solid transparent;
    border-right: 3px solid transparent;
    margin-right: 4px;
}

QValueComboBox:hover {
    border-color: #3a86ff;
}

QValueComboBox:focus {
    border-color: #4a86ff;
    outline: none;
}

QValueComboBox:!hover:!focus {
    border-color: #303030;
}

QValueComboBox QAbstractItemView::item {
    padding: 4px 8px;
    background-color: #1e1e1e;
}

QValueComboBox QAbstractItemView::item:hover {
    background-color: #2d2d2d;
}

QValueComboBox QAbstractItemView::item:selected {
    background-color: #3a86ff;
    color: #ffffff;
}

QValueComboBox QLineEdit {
    background-color: #1e1e1e;
    color: #d0d0d0;
    padding: 0;
    margin: 0;
    border: none;
}
